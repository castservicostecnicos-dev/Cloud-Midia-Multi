# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PERSISTENCE (Render.com Persistent Disks or custom server paths)
# Caso utilize um Persistent Disk no Render.com ou volume persistente Docker (ex: /var/data),
# você pode definir estas variáveis no dashboard para persistir o banco e mídias entre deploys:
# DATA_DIR="/var/data"
# UPLOAD_DIR="/var/data/uploads"
# UPLOADS_DIR="/var/data/uploads"
# (No AI Studio ou ambiente padrão, caso não definidas, o sistema usa ./data e ./uploads locais com sincronização em nuvem via Firestore)

# FIREBASE FIRESTORE CLOUD PERSISTENCE (BANCO DE DADOS INDEPENDENTE & DUPLICADO)
# NOTA: O applet já inclui o arquivo 'firebase-applet-config.json' na raiz do projeto com
# todas as credenciais ativas e funcionais para o Firestore.
# O banco foi DUPLICADO e isolado em 'indoor_media_db_multicast', garantindo 100% de independência
# em relação ao app original.
#
# Caso vá fazer deploy externo no Render.com ou Cloudflare sem incluir o arquivo JSON no repositório Git,
# você pode copiar e colar os seguintes valores nas variáveis de ambiente:
# FIREBASE_PROJECT_ID="deep-freedom-8szp9"
# FIREBASE_API_KEY="AIzaSyCzP6rv9WIneoF9OUDTRppATOsCLOS-vvQ"
# FIRESTORE_DATABASE_ID="ai-studio-remixmdiaindoor2-b21786e5-9cc2-4541-8854-9ca7fb6c84ba"
# FIRESTORE_DOC_ID="indoor_media_db_multicast"
# VITE_FIRESTORE_DOC_ID="indoor_media_db_multicast"
# FIREBASE_APP_ID="1:676316244483:web:bc8f3491e953b884c9fc36"
# FIREBASE_AUTH_DOMAIN="deep-freedom-8szp9.firebaseapp.com"

# DECOUPLED STATIC SITE ARCHITECTURE / CLOUDFLARE PAGES (Opcional)
# Caso decida hospedar o Frontend no Cloudflare Pages e conectar a um backend externo:
# VITE_API_BASE_URL="https://sua-api-backend.onrender.com/api"
# (Caso não configure backend externo no Cloudflare Pages, o sistema utiliza o motor cliente
# direto no Firebase Firestore com total persistência e suporte offline PWA)


